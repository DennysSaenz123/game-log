<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game-Addition</title>
    <link rel="stylesheet" href="/styles/home.css">
    <!--page icon-->
    <link rel="icon" href="/images/game-logo.png">
    <!--font family for title-->
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('header') %>
    <h1>Game Submissions</h1>

<% if (games.length === 0) { %>
    <p>No games submitted yet.</p>
<% } %>

<% games.forEach(game => { %>
    <div>
        <p><strong>Title:</strong> <%= game.title %></p>
        <p><strong>Status:</strong> <%= game.status %></p>
        <p><strong>Rating:</strong> <%= game.rating %></p>
        <p><strong>Submitted:</strong> <%= game.timestamp %></p>
    </div>
    <hr>
<% }) %>
</body>
</html>