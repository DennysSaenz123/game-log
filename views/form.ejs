<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a game</title>
    <!--page icon-->
  <link rel="icon" href="/images/game-logo.png">
    <!-- Main Styles -->
    <link rel="stylesheet" href="/styles/form.css"> 
    <link rel="stylesheet" href="/styles/nav-bar.css">
    <link rel="stylesheet" href="/styles/home.css">

    <!--font family for title-->
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">

    <!-- Script -->
     <script src="/js/form_val.js" defer></script>

</head>
<body>
    <%- include('navbar') %>
    <section class="form">
    <h2>Add a Game</h2>

    <!-- server-side validation errors -->
    <% if (errors && errors.length > 0) { %>
        <div class="server-errors">          
            <% errors.forEach(error => { %>
                <p><%= error %></p>
            <% }) %>     
        </div>
    <% } %>

    <form id="addGameForm" action="/add-game" method="post">
        <fieldset>
            <legend>Game Information</legend>

        <!--Title-->
        <div>
            <label for="title">Game Title</label>
            <input type="text" id="title" name="title" placeholder="Enter game title">
            <span class="err" id="err-title">Please add title</span>
        </div>
        <h3>Status</h3>
        <!--Status-->
        <div>

            <label>
                <input type="radio" name="status" value="playing">
                Currently Playing
            </label>

            <label>
                <input type="radio" onclick="wishlistToggle()" name="status" value="want">
                Want to Play
            </label>

            <label>
                <input type="radio" name="status" value="completed">
                Completed
            </label>
            <span class="err" id="err-status">Please select status</span>
        </div>

        <!-- Rating -->
        <div>
            <label for="rating">Rating (1–10)</label> 
            <select id="rating" name="rating">
                <option value="">Select rating</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">10</option>
            </select>
            <span class="err" id="err-rating">Please select rating</span>
        </div>
         <h3>Genres</h3>
                 </fieldset>
        <!-- Genres  -->
        <div class="genres">
            <label class="genre-item">
                <input type="checkbox" name="genres" value="action">
                <span>Action</span>
            </label>

            <label class="genre-item">
                <input type="checkbox" name="genres" value="rpg">
                <span>RPG</span>
            </label>

            <label class="genre-item">
                <input type="checkbox" name="genres" value="adventure">
                <span>Adventure</span>
            </label>

            <label class="genre-item">
                <input type="checkbox" name="genres" value="sports">
                <span>Sports</span>
            </label>

            <label class="genre-item">
                <input type="checkbox" name="genres" value="strategy">
                <span>Strategy</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="sandbox">
                <span>Sandbox</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="survival">
                <span>Survival</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="shooter">
                <span>Shooter</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="fighting">
                <span>Fighting</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="racing">
                <span>Racing</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="simulation">
                <span>Simulation</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="open">
                <span>Open World</span>
            </label>
            
            <label class="genre-item">
                <input type="checkbox" name="genres" value="puzzle">
                <span>Puzzle</span>
            </label>
        </div>
        <span class="err" id="err-genres">Please select at least one genre</span>
        <h3>Notes</h3>
        <div class="form-group">
            <textarea id="notes" name="notes" rows="4" placeholder="Write your thoughts about the game..." maxlength="400"></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit">Add Game</button>
        <button type="button" id="wishlist-btn">Add Game To Wishlist</button>

    </form>
</section>
</body>
</html>