<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=
    , initial-scale=1.0">
    <title>Sign In - Game Log</title>
    <!-- Main Styles -->
    <link rel="stylesheet" href="/styles/form.css"> 
    <link rel="stylesheet" href="/styles/nav-bar.css">
    <!-- Script -->
    <script src="/js/signin_val.js" defer></script>

</head>
<body>
    <%- include('header') %>
    <section class="add-game">
    <h2>Sign In!</h2>

    <form id="signInForm" action="/sign-in" method="post">
        <!--Username-->
        <div>
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Enter username">
            <span class="err" id="err-username">Please add username</span>
        </div>
        <!--Password-->
        <div>
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter password">
            <span class="err" id="err-password">Please add password</span>
        </div>
        <!-- Submit Button -->
        <button type="submit">Sign In</button>

    </form>
</section>
    <script src="/js/script.js"></script> 
</body>
</html>