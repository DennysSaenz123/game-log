<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In</title>
  <!-- Main Styles -->
  <link rel="stylesheet" href="/styles/form.css">
  <link rel="stylesheet" href="/styles/nav-bar.css">
  <link rel="stylesheet" href="/styles/sign_in.css">
  <!--page icon-->
  <link rel="icon" href="/images/game-logo.ico">
  <!--font family for title-->
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
  <!-- Script -->
  <script src="/js/form_val.js" defer></script>

</head>

<body>
  <%- include('header') %>

  <div class="home-btn-container">
    <a href="/">
      <button class="home-btn">Home</button>
    </a>
  </div>
  
  <section class="form">
    <h2>Sign In</h2>
    <form id="signInForm" action="" method="post">
      <!-- Account Information -->
      <fieldset>
        <legend>Account Information</legend>

        <!--Username-->

        <div>
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="Enter username">
          <span class="err" id="err-username">Please add username</span>
        </div>
        <!--Password-->
        <div>
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter password">
          <span class="err" id="err-password">Please add password</span>
        </div>

      </fieldset>
      <!-- Submit Button -->
      <div>
        <button type="submit">Sign In</button>
      </div>

    </form>
  </section>
</body>

</html>