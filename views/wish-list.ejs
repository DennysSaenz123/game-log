<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games</title>
    <!--page icon-->
    <link rel="icon" type="image/png" href="/images/game-logo.png"> 
     <!-- Nav Bar Styles -->
    <link rel="stylesheet" href="/styles/nav-bar.css">
    <!-- Main Styles -->
     <link rel="stylesheet" href="/styles/home.css">
    <!-- Styling for games -->
    <link rel="stylesheet" href="/styles/games.css">
     <!--font family for title-->
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
    <!-- script -->
    <script src="/scripts/form_val.js" defer></script>
</head>
<body>
  <%- include('navbar') %>
  <main class="games-page">
    <h1 class="page-title">My Games</h1>
  <% if (games && games.length) { %>
    <section class = "games-grid">
        <% games.forEach(function(game) { %>
          <article class="game-card">
            <div class="card-top">
            <h2 class="game-title"><%= game.title ?? 'Untitled Game' %></h2>
            <span class="status-badge"><%= game.status ?? 'No Status' %></span>
          </div>

          <div class="card-body">
            <p><span class="label">Rating:</span> <%= game.rating === null ? 'N/A' : game.rating + '/10' %></p>
            <div class="genres">
              <span class="label">Genres:</span>

              <% if (game.genres) { 
                const genreList = game.genres.split(',');
                genreList.forEach(function(genre) { %>
                  <span class="genre-tag"><%= genre.trim() %></span>
            <%   });
              } else { %>
                <span>No genres listed</span>
              <% }; %>
            </div>%></p>
            <p><span class="label">Notes:</span> <%= game.notes ?? 'No notes yet' %></p>
          </div>
        </article>
      <% }); %>
    </section>
  <% } else { %>
    <p class="empty-state">No games found yet. Add your first game.</p>
  <% } %>
  </main>
</body>
</html>